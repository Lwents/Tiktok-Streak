[Unit]
Description=Private browser screen for TikTok Streak
After=tiktok-streak-display.service
Requires=tiktok-streak-display.service

[Service]
User=tiktok-streak
Group=tiktok-streak
Environment=HOME=/var/lib/tiktok-streak
Environment=DISPLAY=:99
Environment=XAUTHORITY=/var/lib/tiktok-streak/.Xauthority
UMask=0077
ExecStartPre=/opt/tiktok-streak/.venv/bin/python /opt/tiktok-streak/deploy/wait_display.py
ExecStart=/usr/bin/x11vnc -display :99 -auth /var/lib/tiktok-streak/.Xauthority -forever -shared -localhost -listen 127.0.0.1 -noipv6 -rfbport 5900 -nopw
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
